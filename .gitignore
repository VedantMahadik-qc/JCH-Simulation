# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
.ipynb_checkpoints/
.venv/
venv/
.env

# --- Julia ---
*.ji
*.cov
*.mem
# Lockfile: keep out of git for a library - consumers resolve against the
# [compat] bounds in Project.toml, not a pinned snapshot.
/julia/Manifest.toml
deps/build.log

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Generated outputs ---
# Raw numbers are tracked (results/data/*.csv) so the plots are reproducible.
# Rendered media is NOT tracked - it is regenerated by the notebooks.
results/animations/*.gif
results/animations/*.mp4
results/figures/*.png
!results/figures/.gitkeep
!results/animations/.gitkeep

# ...except the showcase assets referenced from the README. These are expensive
# to regenerate (GPU / long mean-field runs), so they are tracked deliberately.
!results/animations/jch_5x5_spread.gif
!results/animations/photon_spread_2d.gif
!results/figures/julia_scaling.png
!results/figures/sparsity_pattern.png
!results/figures/sparsity_pattern_julia.png

# Scratch figures extracted for the report - not repo artefacts
figures_report/
